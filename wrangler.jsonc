// Cloudflare Worker that serves the documentation site as static files.
// Cloudflare builds and deploys it on every push to main (Workers Builds).
{
  "name": "py-euvd-docs",
  "compatibility_date": "2026-11-27",
  "assets": {
    // Where "zensical build" writes the site.
    "directory": "./site",
    // Unknown addresses get the site's 404 page.
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "py-euvd.spoons.fyi", "custom_domain": true }]
}
